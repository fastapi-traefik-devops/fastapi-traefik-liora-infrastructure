# Deliberately unusable placeholders; never use example credentials on a cluster.
# Complete schema and constraints: recovery/README.md.
schema_version: 1
application_credentials:
  dev:
    namespace: app-dev
    # Replace with the account configured in the application ConfigMaps/runbook 13.
    first_superuser: fake-admin@example.invalid
    backend-secrets:
      SECRET_KEY: REPLACE_WITH_INDEPENDENT_DEV_SIGNING_KEY
      FIRST_SUPERUSER_PASSWORD: REPLACE_WITH_DEV_ADMIN_PASSWORD
      POSTGRES_PASSWORD: REPLACE_WITH_DEV_DATABASE_PASSWORD
      SMTP_PASSWORD: '' # Empty is supported when SMTP authentication is disabled.
    db-secrets:
      POSTGRES_PASSWORD: REPLACE_WITH_DEV_DATABASE_PASSWORD
  stage:
    namespace: app-stage
    first_superuser: fake-admin@example.invalid
    backend-secrets:
      SECRET_KEY: REPLACE_WITH_INDEPENDENT_STAGE_SIGNING_KEY
      FIRST_SUPERUSER_PASSWORD: REPLACE_WITH_STAGE_ADMIN_PASSWORD
      POSTGRES_PASSWORD: REPLACE_WITH_STAGE_DATABASE_PASSWORD
      SMTP_PASSWORD: ''
    db-secrets:
      POSTGRES_PASSWORD: REPLACE_WITH_STAGE_DATABASE_PASSWORD
  prod:
    namespace: app-prod
    first_superuser: fake-admin@example.invalid
    backend-secrets:
      SECRET_KEY: REPLACE_WITH_INDEPENDENT_PROD_SIGNING_KEY
      FIRST_SUPERUSER_PASSWORD: REPLACE_WITH_PROD_ADMIN_PASSWORD
      POSTGRES_PASSWORD: REPLACE_WITH_PROD_DATABASE_PASSWORD
      SMTP_PASSWORD: ''
    db-secrets:
      POSTGRES_PASSWORD: REPLACE_WITH_PROD_DATABASE_PASSWORD

# All values below are deliberately fake.
database_backups:
  account_id: REPLACE_WITH_32_HEX_ACCOUNT_ID
  api_token: REPLACE_WITH_OPTIONAL_R2_API_TOKEN
  endpoint: https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
  jurisdiction: default
  region: auto
  bucket: liora-backup
  access_key_id: REPLACE_WITH_32_HEX_R2_ACCESS_KEY
  secret_access_key: REPLACE_WITH_64_HEX_R2_SECRET_KEY
