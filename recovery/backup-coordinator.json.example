  "clusters": {
    "nonprod": {
      "server": "https://192.168.77.11:6443",
      "token": "REPLACE_WITH_NONPROD_COORDINATOR_TOKEN",
      "ca_pem": "REPLACE_WITH_NONPROD_PUBLIC_CA_PEM",
