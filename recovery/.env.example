# Example environment variables for recovery. Replace placeholders in the ignored .env file.
# Run from the repository root: source recovery/.env
# Obtain the replacement Proxmox endpoint and API token during recovery.
# Shared Proxmox API inputs for edge/tailscale/terraform and infrastructure/k3s-cluster/terraform.
# Set PROXMOX_PUBLIC_IP to the replacement host address when SSH access needs it.
export TF_VAR_pm_endpoint='https://192.168.77.1:8006/'
export TF_VAR_pm_node='REPLACE_WITH_PROXMOX_NODE'
export TF_VAR_pm_api_token='REPLACE_WITH_PROXMOX_API_TOKEN'
# Select this once after the template storage preflight; both Terraform modules use the same value.
export DISK_STORAGE='vmdata'
export TF_VAR_cloud_init_datastore_id="$DISK_STORAGE"
export TAILSCALE_API_KEY='XXXXX-XXX-...'
export TAILSCALE_TAILNET='-'
export GHCR_REGISTRY=ghcr.io
export GHCR_USERNAME=AAAAAAA
export GHCR_TOKEN=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
