  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Environment",
        "type": "custom",
        "query": "app-dev,app-stage",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "app-dev",
          "value": "app-dev"
        },
        "options": [
          {
            "text": "app-dev",
