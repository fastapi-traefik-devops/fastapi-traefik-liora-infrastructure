# OpenTofu / Terraform
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfplan
**/*.tfvars
!**/*.tfvars.example
crash.log
crash.*.log

# Secrets
kubernetes/tls/cloudflare-api-token.secret.yaml
.env
*.secret
*.key
*.pem

# Generated local artifacts
.local-work/
kubeconfig
*.kubeconfig

# Editor / OS
.idea/
.vscode/
.DS_Store

# Local recovery inputs are private by default. Keep only the documented
# examples and validator source files eligible for new Git additions.
/recovery/*
!/recovery/README.md
!/recovery/*.example
!/recovery/check_credentials.py
!/recovery/check_credentials.sh
!/recovery/make_recovery_backup.sh
!/recovery/requirements.txt
!/recovery/show_passwords.py
!/recovery/test_check_credentials.py

# Bytecode generated by the standalone backup operator tools
scripts/backups/__pycache__/
scripts/backups/tests/__pycache__/
scripts/recovery/**/__pycache__/
scripts/recovery/__pycache__/
