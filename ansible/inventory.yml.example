all:
  children:
    k3s_servers:
      hosts:
        k3s-01:
          ansible_host: 192.168.77.200
          node_ip: 192.168.77.200
        k3s-02:
          ansible_host: 192.168.77.201
          node_ip: 192.168.77.201
        k3s-03:
          ansible_host: 192.168.77.202
          node_ip: 192.168.77.202

  vars:
    ansible_user: debian
    ansible_become: true
    ansible_python_interpreter: /usr/bin/python3

    k3s_version: "v1.36.4+k3s1"
    k3s_api_vip: "192.168.77.10"
    k3s_vip_interface: "ens18"
    kube_vip_version: "v1.2.3"
