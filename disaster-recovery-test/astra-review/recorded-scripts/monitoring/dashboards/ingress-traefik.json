{
  "uid": "ingress-traefik",
  "title": "NONPROD / Traefik",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "DEV",
    "STAGE",
    "GitOps"
  ],
  "editable": false,
  "panels": [
    {
      "id": 8,
      "title": "Total request rate",
      "description": "Ingress requests/second across observed entrypoints; 5-minute rate. Uses code label; no observed matching status counters means zero only when base request counters exist. No request telemetry remains no data. Existing service panels separate DEV/STAGE using observed service names.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_entrypoint_requests_total[5m]))",
          "legendFormat": "Total request rate",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No telemetry",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "HTTP 2xx rate",
