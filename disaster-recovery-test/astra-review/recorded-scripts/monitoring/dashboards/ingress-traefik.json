          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"4..\"}[5m])) or (0 * sum(rate(traefik_entrypoint_requests_total[5m])))",
          "legendFormat": "HTTP 4xx rate",
          "instant": true
        }
      ],
      "fieldConfig": {
