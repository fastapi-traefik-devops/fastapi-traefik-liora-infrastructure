    {
      "id": 11,
      "title": "HTTP 5xx rate",
      "description": "Ingress requests/second across observed entrypoints; 5-minute rate. Uses code label; no observed matching status counters means zero only when base request counters exist. No request telemetry remains no data. Existing service panels separate DEV/STAGE using observed service names.",
      "type": "stat",
