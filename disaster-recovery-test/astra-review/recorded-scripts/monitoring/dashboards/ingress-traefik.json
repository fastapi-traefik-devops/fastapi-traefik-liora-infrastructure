      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_entrypoint_requests_total{code=~\"2..\"}[5m])) or (0 * sum(rate(traefik_entrypoint_requests_total[5m])))",
          "legendFormat": "HTTP 2xx rate",
          "instant": true
