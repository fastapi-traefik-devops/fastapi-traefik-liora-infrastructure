[Unit]
Description=Read-only Liora backup and R2 usage metrics
Wants=network-online.target
After=network-online.target

[Service]
User=liora-backups
Group=liora-backups
StateDirectory=liora-backups
StateDirectoryMode=0700
ExecStart=/opt/liora-backups/venv/bin/python /opt/liora-backups/metrics.py
Restart=on-failure
RestartSec=15s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077

MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
